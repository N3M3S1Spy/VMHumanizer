{
  "profile_name": "gamer",
  "profile_type": "gamer",
  "mouse": {
    "curve_type": "cubic_bezier",
    "smoothness": 0.95,
    "jitter_amplitude": [1, 3],
    "pause_on_target": false,
    "pause_duration_range": [50, 150],
    "speed_profile": "fast_then_slow"
  },
  "keystroke": {
    "key_hold_duration": [25, 120],
    "inter_key_delay_mean": 80,
    "inter_key_delay_std": 25,
    "error_rate": 0.03,
    "word_pause_range": [30, 150],
    "sentence_pause_range": [100, 400],
    "digraph_timings": {
      "th": 55,
      "he": 60,
      "in": 65,
      "er": 70,
      "wa": 50,
      "sd": 45
    }
  },
  "registry_mru": {
    "enable_typed_urls": true,
    "enable_user_assist": true,
    "enable_office_mru": false,
    "max_urls": 25,
    "max_office_entries": 5,
    "include_programs": [
      "steam.exe",
      "discord.exe",
      "chrome.exe",
      "explorer.exe",
      "taskmgr.exe",
      "spotify.exe",
      "obs64.exe"
    ]
  },
  "event_log": {
    "enabled": true,
    "max_events_per_log": 2000,
    "profile_name": "gamer"
  },
  "activity_engine": {
    "enabled": true,
    "profile": "gamer",
    "timezone_offset": 1,
    "break_frequency_hours": 2.0,
    "distraction_probability": 0.20,
    "activity_intensity": 0.9,
    "log_activities": true
  },
  "network_simulator": {
    "enabled": true,
    "simulate_dns": true,
    "dns_targets": ["store.steampowered.com", "discord.com", "www.twitch.tv", "www.youtube.com", "www.reddit.com", "www.google.com"],
    "simulate_firewall": true,
    "firewall_block_rate": 0.03,
    "simulate_network_shares": false
  }
}
